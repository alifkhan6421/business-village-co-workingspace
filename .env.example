# Copy to .env.local for local development, or set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values. Only variables prefixed NEXT_PUBLIC_ reach the browser.

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for guest bookings, email logs, uploads and admin user management.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---------------------------------------------------------------------
# Public base URL, used in email links, sitemap, canonical and hreflang tags.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (Resend) ------------------------------------------------------------
# Server-only. Without it, emails are logged as "failed" in Admin → Email logs and not sent.
RESEND_API_KEY=
# Leave empty for Resend. Tests point this at the local mock: http://127.0.0.1:4010
EMAIL_API_BASE_URL=
# Must use a domain verified in Resend (see README → Email / DNS).
EMAIL_FROM="Business Village <booking@business-village.de>"
EMAIL_REPLY_TO=booking@business-village.de

# --- Inbound email (optional) ---------------------------------------------------
# Signing secret of the Resend webhook pointing at /api/webhooks/resend.
# Leave empty until receiving is configured; the endpoint then answers 503.
RESEND_WEBHOOK_SECRET=
